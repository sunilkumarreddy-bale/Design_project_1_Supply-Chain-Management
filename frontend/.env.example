# Leave empty in development: Vite proxies /api, /uploads and /socket.io to VITE_PROXY_TARGET.
# For Vercel set them to the API origin, e.g. https://api.example.com/api and https://api.example.com
VITE_API_URL=
VITE_SOCKET_URL=
# Dev proxy target (docker-compose sets http://backend:4000)
VITE_PROXY_TARGET=http://localhost:4000
# Optional: Google Maps JavaScript API key for the warehouse map (a built-in schematic map is used without it)
VITE_GOOGLE_MAPS_KEY=
