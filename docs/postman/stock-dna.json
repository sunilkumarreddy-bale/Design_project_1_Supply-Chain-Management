{
  "info": {
    "name": "Smart Inventory SCM - Stock DNA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every /api/dna route plus order reserve/ship. Run \"Login\" first; set lotId from GET /dna/lots."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "warehouseId",
      "value": ""
    },
    {
      "key": "otherWarehouseId",
      "value": ""
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "finishedProductId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    },
    {
      "key": "transferId",
      "value": ""
    },
    {
      "key": "countId",
      "value": ""
    },
    {
      "key": "countLineId",
      "value": ""
    },
    {
      "key": "discrepancyId",
      "value": ""
    },
    {
      "key": "poId",
      "value": ""
    },
    {
      "key": "alertId",
      "value": ""
    },
    {
      "key": "recoveryPlanId",
      "value": ""
    },
    {
      "key": "stockLevelId",
      "value": ""
    },
    {
      "key": "redistributionPlanId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "dependencyId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "lotId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set('token', b.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
