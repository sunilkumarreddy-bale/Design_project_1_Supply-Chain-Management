# --- Core ---
NODE_ENV=development
PORT=4000
# Local docker replica set (transactions need a replica set). Atlas example:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/smart_inventory?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_inventory?replicaSet=rs0&directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Public base URL of this API (used for links to locally stored uploads by the mock storage driver)
PUBLIC_BASE_URL=http://localhost:4000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Run expiry sweep and overdue-PO checks every N minutes (0 disables)
SCHEDULER_INTERVAL_MINUTES=60

# --- Storage (Cloudinary for images / attachments, S3 for documents). Leave empty for the local mock driver ---
STORAGE_PROVIDER=
CLOUDINARY_URL=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email: sendgrid | smtp | console (console is used automatically when keys are missing) ---
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@smart-inventory.local
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- SMS: twilio | gateway | console ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=

# --- Google Maps (geocoding and distance). Empty = deterministic mock ---
GOOGLE_MAPS_API_KEY=

# --- Payments (optional, behind a feature flag): razorpay | stripe ---
ENABLE_PAYMENTS=false
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
